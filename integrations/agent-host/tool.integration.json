{
  "schemaVersion": "openadam.agent-host-tool-integration.v0.5",
  "displayName": "Math Anchor",
  "summary": "Scoped mathematical checks with a compact four-tool MCP compatibility runtime.",
  "codex": {
    "marketplaceRoot": "marketplace",
    "marketplace": "openadam-math-anchor",
    "pluginRoot": "marketplace/plugins/math-anchor-obligation-runtime",
    "plugin": "math-anchor-obligation-runtime",
    "identityFiles": [
      ".codex-plugin/plugin.json",
      ".mcp.json",
      "skills/calculate/SKILL.md"
    ]
  },
  "runtime": {
    "transport": "mcp-stdio",
    "executor": "component",
    "command": "marketplace/plugins/math-anchor-obligation-runtime/runtime/math-anchor-runtime/math-anchor-runtime",
    "args": ["mcp"],
    "cwd": "marketplace/plugins/math-anchor-obligation-runtime",
    "workspaceEnvironment": [],
    "optionalPathEnvironment": [],
    "expectedTools": [
      "math.search",
      "math.describe",
      "math.run",
      "math.batch"
    ],
    "timeoutMs": 30000
  },
  "ownership": {
    "uninstall": "agent-host-created-only"
  }
}
